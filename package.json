{
  "name": "web-dev-toolbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "postgenerate": "node scripts/build-404.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:seo": "node tests/generated/seo.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "gifenc": "1.0.3",
    "jszip": "3.10.1",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.1.0"
  }
}
